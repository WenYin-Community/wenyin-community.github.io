# wenyinos 统一认证中心 · 环境配置模板
# 复制为 .env 并填写实际值；.env 已被 gitignore，不会进入仓库（代码全量开源）

# ── 数据库 ──
WY_DB_HOST=127.0.0.1
WY_DB_PORT=3306
WY_DB_NAME=wenyinos_auth
WY_DB_USER=wenyinos_auth
WY_DB_PASS=change-me

# ── 票据签名密钥（openssl rand -hex 32 生成，务必保密）──
WY_TICKET_KEY=change-me-64-hex
# 票据有效期（秒）：分站登录态继承依赖此票据，同时决定 wy_auth cookie 生命周期。
# 该值就是三个分站（PasteBin / 论坛 / 禅道）登录态的实际上限，只在中心登录时签发、不做滑动续期。
# 取 604800（7 天）；过短（如 7200/2 小时）会导致用户被频繁登出。登出仍会即时 revoke 票据。
WY_TICKET_TTL=604800

# ── Cookie（生产：.wenyinos.com 域名 + secure true；本地联调：.wenyinos.test + false）──
WY_COOKIE_DOMAIN=.wenyinos.com
WY_COOKIE_SECURE=true

WY_TIMEZONE=Asia/Shanghai

# ── 站点入口（账号面板跳转）──
WY_SITE_FORUM=https://forum.wenyinos.com/
WY_SITE_DEV=https://dev.wenyinos.com/
WY_SITE_PASTE=https://paste.wenyinos.com/

# ── 中心自身对外地址（用于邮件中的重置链接等绝对 URL）──
# 本地联调：http://auth.wenyinos.test:8080/auth
WY_BASE_URL=https://wenyinos.com/auth
